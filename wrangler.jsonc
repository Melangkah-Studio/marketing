{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "melangkah-studio-marketing",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "melangkahstudio.site",
      "custom_domain": true
    }
  ]
}

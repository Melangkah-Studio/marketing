{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "melangkah-studio-marketing",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "melangkahstudio.site",
      "custom_domain": true
    }
  ]
}

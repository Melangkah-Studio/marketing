---
import { Image } from "astro:assets";
import Hero from "@/assets/imgs/hero.png";
---

<section id="section-1">
  <h1 class="melangkah">Melangkah<span class="sr-only"> Studio</span></h1>
  <div class="hero-container">
    <Image alt="Melangkah Studio Hero Image" class="hero" priority src={Hero} />
    <span aria-hidden="true" class="studio">Studio</span>
  </div>
</section>

<style>
  #section-1 {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }

  .melangkah {
    position: relative;
    bottom: -1px;
    left: 4px;
    z-index: 1;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 800;
    color: #333333;
    letter-spacing: -0.05em;
    text-box: trim-end cap alphabetic;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
  }

  .hero-container {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
  }

  .hero {
    width: 100%;
    height: 100%;
    aspect-ratio: 1.76 / 1;
    pointer-events: none;
    object-fit: cover;
    object-position: 90% 0%;
  }

  .studio {
    position: absolute;
    right: 0;
    bottom: 1px;
    font-size: clamp(5rem, 10vw, 7rem);
    font-weight: 800;
    color: white;
    letter-spacing: -0.05em;
    text-box: trim-both ex alphabetic;
  }
</style>

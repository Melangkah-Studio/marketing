---
import { Image } from "astro:assets";
import FlowerOutline from "@/assets/imgs/flower-outline.png";
---

<section id="section-2">
  <h2>Turning human ideas into digital things</h2>
  <Image alt="Flower" src={FlowerOutline} />
  <p>
    Melangkah Studio is a small independent studio built around curiosity,
    craft, and people
  </p>
</section>

<style>
  #section-2 {
    position: relative;
    height: 100vh;
    overflow: hidden;
  }

  h2 {
    padding: 1rem;
    font-size: 2rem;
    font-weight: 700;
    color: #333333;
    letter-spacing: -0.05em;
  }

  img {
    position: absolute;
    bottom: 5rem;
    left: 50%;
    width: auto;
    height: 70%;
    aspect-ratio: 0.422 / 1;
    pointer-events: none;
    object-fit: cover;
    object-position: center;
    transform: translateX(-50%);
  }

  p {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
    color: #333333;
    letter-spacing: -0.05em;
  }

  @media (min-width: 425px) {
    h2 {
      font-size: 3rem;
    }

    img {
      bottom: 0;
      height: 70%;
    }

    p {
      right: 0;
      left: auto;
      width: 40%;
      font-size: 1.25rem;
    }
  }

  @media (min-width: 768px) {
    h2 {
      font-size: 4rem;
    }

    p {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    h2 {
      font-size: 6rem;
    }

    p {
      font-size: 1.75rem;
    }
  }

  @media (min-width: 1440px) {
    h2 {
      font-size: 7rem;
    }

    p {
      font-size: 2rem;
    }
  }
</style>

---
import { Image } from "astro:assets";
import PrivateWellness from "@/assets/imgs/portfolios/private-wellness.png";
import TedxUB2025 from "@/assets/imgs/portfolios/tedx-ub-2025.png";
import TedxUB2026 from "@/assets/imgs/portfolios/tedx-ub-2026.png";
import TummyYammy from "@/assets/imgs/portfolios/tummyyammy.png";

const portfolios = [
  {
    alt: "Tummy Yammy",
    aspectRatio: 1.099,
    height: "80%",
    id: "tummyyammy",
    image: TummyYammy,
    title: "Tummyyammy",
    year: "2025",
  },
  {
    alt: "TEDx UB 2025",
    aspectRatio: 1.333,
    height: "50%",
    id: "tedx-ub-2025",
    image: TedxUB2025,
    title: "TEDxUniversitas Brawijaya",
    year: "2025",
  },
  {
    alt: "TEDx UB 2026",
    aspectRatio: 1.333,
    height: "100%",
    id: "tedx-ub-2026",
    image: TedxUB2026,
    title: "TEDxUniversitas Brawijaya",
    year: "2026",
  },
  {
    alt: "Private Wellness",
    aspectRatio: 1,
    height: "70%",
    id: "private-wellness",
    image: PrivateWellness,
    title: "Private Wellness",
    year: "2026",
  },
];
---

<section id="section-3">
  <div class="viewport">
    <h3>Some things we've made along the way</h3>
    <div class="container">
      {portfolios.map((portfolio) => (
          <article class="portfolio" id={portfolio.id}>
            <div class="portfolio-header">
              <span class="portfolio-title">{portfolio.title}</span>
              <span class="portfolio-year">{portfolio.year}</span>
            </div>
            <div
              class="image-container"
              style={`--aspect-ratio-x: ${portfolio.aspectRatio}; --height: ${portfolio.height};`}
            >
              <Image alt={portfolio.alt} src={portfolio.image} />
            </div>
          </article>
        ))}
      <div class="portfolio">
        <div class="contact-card">
          <span class="contact-title">Got Something<br>in Mind?</span>
          <a
            class="button"
            href="/contact/"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>We'd love to hear about it</span>
            <svg
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 20 20"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <title>Arrow Right</title>
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("#section-3");
  const viewport = section?.querySelector<HTMLElement>(".viewport");
  const container = section?.querySelector<HTMLElement>(".container");

  if (section && viewport && container) {
    let horizontalDistance = 0;
    let frameId = 0;

    const render = () => {
      frameId = 0;

      const verticalDistance = section.offsetHeight - viewport.offsetHeight;
      const sectionTop = section.getBoundingClientRect().top;
      const progress =
        verticalDistance > 0
          ? Math.min(Math.max(-sectionTop / verticalDistance, 0), 1)
          : 0;

      container.style.transform = `translate3d(${-horizontalDistance * progress}px, 0, 0)`;
    };

    const requestRender = () => {
      if (frameId === 0) {
        frameId = window.requestAnimationFrame(render);
      }
    };

    const measure = () => {
      horizontalDistance = Math.max(
        container.scrollWidth - viewport.clientWidth,
        0
      );
      section.style.setProperty("--viewport-height", `${window.innerHeight}px`);
      section.style.setProperty("--scroll-distance", `${horizontalDistance}px`);
      requestRender();
    };

    const resizeObserver = new ResizeObserver(measure);
    resizeObserver.observe(container);
    resizeObserver.observe(viewport);

    window.addEventListener("scroll", requestRender, { passive: true });
    window.addEventListener("resize", measure, { passive: true });
    measure();
  }
</script>

<style>
  #section-3 {
    --scroll-distance: 0px;
    --viewport-height: 100vh;

    position: relative;
    height: calc(var(--viewport-height) + var(--scroll-distance));
  }

  .viewport {
    position: sticky;
    top: 0;
    height: var(--viewport-height);
    overflow: clip;
  }

  h3 {
    padding: 1rem;
    font-size: 1rem;
    font-weight: 500;
    color: #333333;
    letter-spacing: -0.05em;
  }

  .container {
    position: absolute;
    bottom: 0;
    left: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
    width: max-content;
    min-width: 100%;
    height: 50%;
    padding: 1rem;
    will-change: transform;
  }

  .portfolio {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: flex-end;
    width: auto;
    height: 100%;
  }

  .portfolio-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
  }

  .portfolio-title,
  .portfolio-year {
    font-size: 1rem;
    font-weight: 500;
    color: #333333;
    letter-spacing: -0.05em;
  }

  .image-container {
    width: 100%;
    height: var(--height);
    aspect-ratio: var(--aspect-ratio-x, 1) / 1;
    overflow: hidden;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    pointer-events: none;
    object-fit: cover;
    object-position: center;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 70%;
    aspect-ratio: 1;
    padding: 1rem 0;
    container-type: inline-size;
    color: white;
    text-decoration: none;
    background-color: #333333;
  }

  .contact-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 0.95;
    text-align: center;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .button {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    font-size: 1rem;
    font-weight: 500;
    color: white;
    text-decoration: none;
    background-color: transparent;
    border: none;
  }

  .button svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .button:focus,
  .button:hover {
    text-decoration: underline;
  }

  .button:focus {
    outline: none;
  }

  @media (min-width: 425px) {
    h3 {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    h3 {
      font-size: 2rem;
    }
  }
</style>

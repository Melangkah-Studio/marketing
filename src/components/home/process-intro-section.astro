---
import { Image } from "astro:assets";
import HowWeMove from "@/assets/imgs/how-we-move.png";
---

<section aria-labelledby="how-we-move-title" id="section-5">
  <div class="stage">
    <div class="copy" data-scroll-zoom-copy>
      <h2 id="how-we-move-title">How we move</h2>
      <p>
        There's more than one way to get there. We explore different ideas and
        perspectives to discover what feels right
      </p>
    </div>
    <div class="frame" data-scroll-zoom-frame>
      <Image alt="A person moving through a sunlit field" src={HowWeMove} />
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("#section-5");
  const frame = section?.querySelector<HTMLElement>("[data-scroll-zoom-frame]");
  const copy = section?.querySelector<HTMLElement>("[data-scroll-zoom-copy]");

  if (section && frame && copy) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let animationFrame = 0;

    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const ease = (value: number) => 1 - (1 - value) ** 3;

    const render = () => {
      animationFrame = 0;

      if (reducedMotion.matches) {
        frame.style.setProperty("--frame-width", "calc(100vw - 2rem)");
        frame.style.setProperty("--frame-height", "calc(100svh - 2rem)");
        frame.style.setProperty("--frame-radius", "0px");
        frame.style.setProperty("--image-scale", "1");
        copy.style.setProperty("--copy-opacity", "0");
        return;
      }

      const bounds = section.getBoundingClientRect();
      const scrollDistance = Math.max(1, bounds.height - window.innerHeight);
      const progress = clamp(-bounds.top / scrollDistance);
      const zoomProgress = ease(clamp(progress / 0.9));
      const isMobile = window.innerWidth < 768;
      const horizontalInset = isMobile ? 0.17 : 0.32;
      const verticalInset = isMobile ? 0.3 : 0.29;
      const width =
        window.innerWidth * (1 - horizontalInset * 2 * (1 - zoomProgress));
      const height =
        window.innerHeight * (1 - verticalInset * 2 * (1 - zoomProgress));
      const radius = (isMobile ? 24 : 32) * (1 - zoomProgress);
      const imageScale = 1.08 - zoomProgress * 0.08;
      const copyOpacity = 1 - ease(clamp((progress - 0.08) / 0.46));

      frame.style.setProperty("--frame-width", `${width}px`);
      frame.style.setProperty("--frame-height", `${height}px`);
      frame.style.setProperty("--frame-radius", `${radius}px`);
      frame.style.setProperty("--image-scale", `${imageScale}`);
      copy.style.setProperty("--copy-opacity", `${copyOpacity}`);
    };

    const scheduleRender = () => {
      if (animationFrame === 0) {
        animationFrame = window.requestAnimationFrame(render);
      }
    };

    render();
    window.addEventListener("scroll", scheduleRender, { passive: true });
    window.addEventListener("resize", scheduleRender);
    reducedMotion.addEventListener("change", scheduleRender);
  }
</script>

<style>
  #section-5 {
    position: relative;
    height: 220svh;
    background-color: white;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .copy {
    --copy-opacity: 1;

    position: absolute;
    inset: 0;
    z-index: 1;
    color: #333333;
    opacity: var(--copy-opacity);
    will-change: opacity;
  }

  h2,
  p {
    position: absolute;
    top: 50%;
    letter-spacing: -0.05em;
    transform: translateY(-50%);
  }

  h2 {
    left: 1rem;
    font-size: clamp(1.75rem, 4vw, 4rem);
    font-weight: 600;
    white-space: nowrap;
  }

  p {
    right: 1rem;
    width: min(27vw, 24rem);
    font-size: clamp(1rem, 1.45vw, 1.4rem);
    text-wrap: balance;
  }

  .frame {
    --frame-height: 42svh;
    --frame-radius: 2rem;
    --frame-width: 36vw;
    --image-scale: 1.08;

    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: var(--frame-width);
    height: var(--frame-height);
    overflow: hidden;
    border-radius: var(--frame-radius);
    transform: translate(-50%, -50%);
    will-change: width, height, border-radius;
  }

  .frame img {
    width: 100%;
    height: 100%;
    pointer-events: none;
    object-fit: cover;
    object-position: center;
    transform: scale(var(--image-scale));
    will-change: transform;
  }

  @media (max-width: 767px) {
    h2,
    p {
      left: 1rem;
      width: calc(100% - 2rem);
      transform: none;
    }

    h2 {
      top: 10%;
    }

    p {
      top: auto;
      right: auto;
      bottom: 8%;
      max-width: 24rem;
    }

    .frame {
      --frame-height: 40svh;
      --frame-radius: 1.5rem;
      --frame-width: 66vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #section-5 {
      height: 100svh;
    }

    .frame,
    .frame img {
      will-change: auto;
    }
  }
</style>

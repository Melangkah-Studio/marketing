---
import "@/styles/globals.css";
import SmoothScroll from "./smooth-scroll.astro";
import Umami from "./umami.astro";

interface Props {
  canonical?: false | string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  title?: string;
}

const {
  title = "Melangkah Studio — Digital Design, Software & AI",
  description = "Melangkah Studio designs and builds thoughtful websites, apps, software, and AI solutions that turn human ideas into useful digital experiences.",
  canonical,
  noindex = false,
  ogImage,
} = Astro.props;
const siteUrl = Astro.site;
const canonicalUrl =
  canonical === false
    ? undefined
    : canonical || new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage
  ? new URL(ogImage, siteUrl).href
  : new URL("/og-image.png", siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    telephone: "+62 813-5781-1710",
  },
  email: "melangkahstd@gmail.com",
  name: "Melangkah Studio",
  sameAs: ["https://www.instagram.com/melangkahstudio/"],
  url: new URL("/", siteUrl).href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta content={Astro.generator} name="generator">

    <title>{title}</title>
    <meta content={description} name="description">
    {noindex && <meta content="noindex, nofollow" name="robots" />}

    <!-- Canonical URL -->
    {canonicalUrl && <link href={canonicalUrl} rel="canonical" />}

    <!-- Favicons -->
    <link href="/favicon.ico" rel="icon" type="image/x-icon">
    <link href="/favicon-16x16.png" rel="icon" sizes="16x16" type="image/png">
    <link href="/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png">
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180">
    <link href="/site.webmanifest" rel="manifest">

    <!-- Theme Color -->
    <meta content="#333333" name="theme-color">

    <!-- Preconnect for Google Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">

    <!-- Google Fonts with optimized loading -->
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    >

    <!-- Open Graph -->
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content="website" property="og:type">
    {canonicalUrl && <meta content={canonicalUrl} property="og:url" />}
    <meta content={ogImageUrl} property="og:image">
    <meta content="1200" property="og:image:width">
    <meta content="630" property="og:image:height">
    <meta content="Melangkah Studio" property="og:image:alt">
    <meta content="Melangkah Studio" property="og:site_name">

    <!-- Twitter Card -->
    <meta content="summary_large_image" name="twitter:card">
    <meta content={title} name="twitter:title">
    <meta content={description} name="twitter:description">
    <meta content={ogImageUrl} name="twitter:image">
    <meta content="Melangkah Studio" name="twitter:image:alt">

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Umami Analytics -->
    {import.meta.env.PROD && (
        <>
          <link crossorigin href="https://cloud.umami.is" rel="preconnect" />
          <Umami websiteId="a3569c6c-3ef9-4e82-bab7-5733d35561ed" />
        </>
      )}
  </head>
  <body>
    <slot />
    <SmoothScroll />
  </body>
</html>

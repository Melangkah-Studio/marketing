---
import { Image } from "astro:assets";
import Flower1 from "@/assets/imgs/flower-1.png";
import Layout from "@/components/layout.astro";
import { constant } from "@/lib/constant";
---

<Layout canonical={false} noindex title={`404 — ${constant.APP_NAME}`}>
  <main>
    <Image alt="" class="flower-1" src={Flower1} />
    <div class="container">
      <h1>Looks like we took a wrong turn</h1>
      <a class="back-home" href="/"
        >Back to Home
        <svg
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 20 20"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title>Arrow Right</title>
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg></a
      >
    </div>
    <p>This page seems to have wandered somewhere else.</p>
  </main>
</Layout>

<style>
  main {
    position: relative;
    height: 100vh;
    background-color: #333333;
  }

  img {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 20rem;
    height: auto;
    aspect-ratio: 0.967 / 1;
    pointer-events: none;
    object-fit: cover;
    object-position: center;
    transform: translate(-100%, -60%);
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: end;
    padding: 1rem;
  }

  h1 {
    font-size: clamp(2rem, 10vw, 7rem);
    font-weight: 700;
    color: white;
    letter-spacing: -0.05em;
    text-wrap: balance;
    text-box: trim-end cap alphabetic;
  }

  .back-home {
    display: flex;
    flex-shrink: 0;
    gap: 0.5rem;
    align-items: center;
    font-size: clamp(1rem, 5vw, 2rem);
    font-weight: 400;
    color: white;
    text-decoration: none;
  }

  .back-home svg {
    width: 0.75em;
    height: 0.75em;
  }

  p {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-size: clamp(1rem, 5vw, 2rem);
    font-weight: 400;
    color: #969696;
    letter-spacing: -0.05em;
  }
</style>

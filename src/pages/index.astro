---
import Hero from "@/assets/imgs/hero.png";
import Layout from "@/components/layout.astro";
import { Image } from "astro:assets";
---

<Layout>
  <main>
    <div id="section-1">
      <h2 class="melangkah">Melangkah</h2>
      <div class="hero-container">
        <Image
          alt="Melangkah Studio Hero Image"
          class="hero"
          priority
          src={Hero}
        />
        <h2 class="studio">Studio</h2>
      </div>
    </div>
  </main>
</Layout>
<style>
  main {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background-color: white;
  }
  #section-1 {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  #section-1 .melangkah {
    position: relative;
    left: 4px;
    bottom: -1px;
    font-size: clamp(3rem, 10vw, 7rem);
    letter-spacing: -0.05em;
    text-box: trim-end cap alphabetic;
    font-weight: 800;
    color: #333333;
    z-index: 1;
  }

  #section-1 .hero-container {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
  }

  #section-1 .hero {
    width: 100%;
    height: 100%;
    aspect-ratio: 1.76 / 1;
    pointer-events: none;
    object-fit: cover;
    object-position: 90% 0%;
  }

  #section-1 .studio {
    position: absolute;
    right: 0;
    bottom: 1px;
    text-box: trim-both ex alphabetic;
    font-size: clamp(5rem, 10vw, 7rem);
    font-weight: 800;
    color: white;
    letter-spacing: -0.05em;
  }
</style>

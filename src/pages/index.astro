---
import { Image } from "astro:assets";
import FlowerOutline from "@/assets/imgs/flower-outline.png";
import Hero from "@/assets/imgs/hero.png";
import Layout from "@/components/layout.astro";
---

<Layout>
  <main>
    <div id="section-1">
      <h2 class="melangkah">Melangkah</h2>
      <div class="hero-container">
        <Image
          alt="Melangkah Studio Hero Image"
          class="hero"
          priority
          src={Hero}
        />
        <h2 class="studio">Studio</h2>
      </div>
    </div>
    <div id="section-2">
      <h2>Turning human ideas into digital things</h2>
      <Image alt="Flower" src={FlowerOutline} />
      <p>
        Melangkah Studio is a small independent studio built around curiosity,
        craft, and people
      </p>
    </div>
    <div id="section-3">

    </div>
    <div id="section-4">

    </div>
    <div id="section-5">

    </div>
    <div id="section-6">

    </div>
    <div id="section-7">

    </div>
    <div id="section-8">

    </div>
  </main>
</Layout>
<style>
  main {
    position: relative;
    overflow: hidden;
    background-color: white;
  }
  #section-1 {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }

  #section-1 .melangkah {
    position: relative;
    left: 4px;
    bottom: -1px;
    font-size: clamp(3rem, 10vw, 7rem);
    letter-spacing: -0.05em;
    text-box: trim-end cap alphabetic;
    font-weight: 800;
    color: #333333;
    z-index: 1;
  }

  #section-1 .hero-container {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
  }

  #section-1 .hero {
    width: 100%;
    height: 100%;
    aspect-ratio: 1.76 / 1;
    pointer-events: none;
    object-fit: cover;
    object-position: 90% 0%;
  }

  #section-1 .studio {
    position: absolute;
    right: 0;
    bottom: 1px;
    text-box: trim-both ex alphabetic;
    font-size: clamp(5rem, 10vw, 7rem);
    font-weight: 800;
    color: white;
    letter-spacing: -0.05em;
  }

  #section-2 {
    position: relative;
    height: 100vh;
    overflow: hidden;
  }

  #section-2 h2 {
    padding: 1rem;
    font-size: 2rem;
    font-weight: 700;
    color: #333333;
    letter-spacing: -0.05em;
  }

  #section-2 img {
    position: absolute;
    bottom: 5rem;
    left: 50%;
    width: auto;
    height: 70%;
    aspect-ratio: 0.422 / 1;
    pointer-events: none;
    object-fit: cover;
    object-position: center;
    transform: translateX(-50%);
  }

  #section-2 p {
    position: absolute;
    right: auto;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
    color: #333333;
    letter-spacing: -0.05em;
    /* transform: translateX(-50%); */
  }

  @media (min-width: 425px) {
    #section-2 h2 {
      font-size: 3rem;
    }

    #section-2 img {
      bottom: 0;
      height: 70%;
    }

    #section-2 p {
      right: 0;
      left: auto;
      width: 40%;
      font-size: 1.25rem;
    }
  }

  @media (min-width: 768px) {
    #section-2 h2 {
      font-size: 4rem;
    }

    #section-2 p {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    #section-2 h2 {
      font-size: 6rem;
    }

    #section-2 p {
      font-size: 1.75rem;
    }
  }

  @media (min-width: 1440px) {
    #section-2 h2 {
      font-size: 7rem;
    }

    #section-2 p {
      font-size: 2rem;
    }
  }

  #section-3 {
    height: 100vh;
    background-color: yellow;
  }

  #section-4 {
    height: 100vh;
    background-color: blue;
  }

  #section-5 {
    height: 100vh;
    background-color: green;
  }

  #section-6 {
    height: 100vh;
    background-color: red;
  }

  #section-7 {
    height: 100vh;
    background-color: purple;
  }

  #section-8 {
    height: 100vh;
    background-color: orange;
  }
</style>

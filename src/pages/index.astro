---
import ContactSection from "@/components/home/contact-section.astro";
import HeroSection from "@/components/home/hero-section.astro";
import IntroSection from "@/components/home/intro-section.astro";
import PortfolioSection from "@/components/home/portfolio-section.astro";
import ProcessIntroSection from "@/components/home/process-intro-section.astro";
import ProcessStepsSection from "@/components/home/process-steps-section.astro";
import ServicesSection from "@/components/home/services-section.astro";
import SpacerSection from "@/components/home/spacer-section.astro";
import Layout from "@/components/layout.astro";
---

<Layout>
  <main>
    <HeroSection />
    <IntroSection />
    <PortfolioSection />
    <ServicesSection />
    <ProcessIntroSection />
    <ProcessStepsSection />
    <SpacerSection />
    <ContactSection />
  </main>
</Layout>

<style>
  main {
    position: relative;
    overflow: hidden;
    background-color: white;
  }
</style>
